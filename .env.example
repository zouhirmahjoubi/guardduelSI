# guardduelSI — Environment Variables (example)
# Copy this file to .env and fill in values.
# NEVER commit real credentials to the repository.

# Supabase — required for optional Live mode (edge function proxy)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OPENAI_API_KEY — set as a Supabase Edge Function secret (NOT in .env)
# In Supabase dashboard: Project Settings > Edge Functions > Secrets
# OPENAI_API_KEY=sk-...  (server-side only)

# OPENAI_MODEL — optional, defaults to gpt-4o-mini
# Set as a Supabase Edge Function secret
# OPENAI_MODEL=gpt-4o-mini
